# IFC Platform Environment Variables

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ifc_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ifc_db
DATABASE_USER=ifc_user
DATABASE_PASSWORD=secure_password

# JWT & Security
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_REFRESH_SECRET=your_refresh_token_secret
BCRYPT_ROUNDS=10

# Discord OAuth2
DISCORD_CLIENT_ID=your_discord_app_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_GUILD_ID=1546948838651334697
DISCORD_WEBSITE_ORGANIZER_ROLE_ID=1548394033720729651

# Server
PORT=3001
NODE_ENV=development
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Discord Bot
BOT_PREFIX=!
BOT_STATUS=IFC League | /help
